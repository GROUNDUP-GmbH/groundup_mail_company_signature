<odoo>
    <!--
        The per-company signatures are shown as a read-only list; editing happens
        in a dialog. The rich text editor (html_mail) must not be placed inside a
        list cell - it renders as a full editor and collapses the row.
    -->
    <record id="view_users_form_company_signature" model="ir.ui.view">
        <field name="name">res.users.form.company.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="company_signature_ids" nolabel="1" colspan="2"
                       invisible="companies_count &lt;= 1"
                       context="{'default_user_id': id}">
                    <list>
                        <field name="company_id"/>
                        <field name="signature" widget="html"/>
                    </list>
                    <form>
                        <group>
                            <field name="user_id" invisible="1"/>
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                        <field name="signature" widget="html_mail"
                               options="{'codeview': true, 'height': 140, 'resizable': true}"/>
                    </form>
                </field>
            </xpath>
            <field name="signature" position="attributes">
                <attribute name="help">Default signature. A company-specific signature overrides it for emails sent from that company.</attribute>
            </field>
        </field>
    </record>

    <record id="view_users_form_simple_modif_company_signature" model="ir.ui.view">
        <field name="name">res.users.preferences.form.company.signature</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="company_signature_ids" nolabel="1" colspan="2"
                       invisible="companies_count &lt;= 1"
                       context="{'default_user_id': id}">
                    <list>
                        <field name="company_id"/>
                        <field name="signature" widget="html"/>
                    </list>
                    <form>
                        <group>
                            <field name="user_id" invisible="1"/>
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                        <field name="signature" widget="html_mail"
                               options="{'codeview': true, 'height': 140, 'resizable': true}"/>
                    </form>
                </field>
            </xpath>
            <field name="signature" position="attributes">
                <attribute name="help">Default signature. A company-specific signature overrides it for emails sent from that company.</attribute>
            </field>
        </field>
    </record>
</odoo>
